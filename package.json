{
  "name": "cleanframe-theme",
  "version": "1.0.1",
  "description": "A clean, light-only Linux desktop theme focusing on visual consistency and readability",
  "main": "index.js",
  "scripts": {
    "build": "bash scripts/build-theme.sh",
    "lint:scss": "stylelint \"src/**/*.scss\"",
    "lint:scss:fix": "stylelint \"src/**/*.scss\" --fix",
    "build:scss:smoke": "bash scripts/scss-smoke.sh",
    "audit:gaps": "bash scripts/audit-theme-gaps.sh",
    "audit:colors": "bash scripts/audit-color-leaks.sh",
    "audit:colors:strict": "bash scripts/audit-color-leaks.sh --strict",
    "audit:unused": "bash scripts/audit-unused-assets.sh",
    "test:ci": "npm run lint:scss && npm run audit:colors:strict && npm run build:scss:smoke",
    "test": "npm run lint:scss && npm run audit:colors && npm run build:scss:smoke"
  },
  "keywords": [
    "gtk-theme",
    "gtk3",
    "gtk4",
    "gnome-shell",
    "cinnamon",
    "xfwm4",
    "light-theme"
  ],
  "author": "sfairmm <g00gle.lags@gmail.com>",
  "license": "GPL-3.0-or-later",
  "type": "commonjs",
  "devDependencies": {
    "stylelint": "^17.3.0",
    "stylelint-config-standard-scss": "^17.0.0"
  }
}
